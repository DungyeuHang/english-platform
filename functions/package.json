{
  "name": "english-platform-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase callable functions for English Platform (admin user + class membership operations).",
  "main": "lib/index.js",
  "engines": {
    "node": "18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run"
  },
  "dependencies": {
    "english-platform": "file:..",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "~5.6.2",
    "vitest": "^2.1.2"
  }
}
