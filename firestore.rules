rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isRole(role) {
      return isSignedIn() && getUserData(request.auth.uid).role == role && getUserData(request.auth.uid).status == 'active';
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isTeacher() {
      return isRole('teacher');
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for 'users' collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // Admins can update anything.
      // Users can update their own profile, but NOT their role, status, or classIds.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.classIds == resource.data.classIds
      );
    }

    // Rules for 'classes' collection
    match /classes/{classId} {
      // Admins, the assigned teacher, or an enrolled student can read.
      allow read: if isAdmin() ||
                     (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                     (getUserData(request.auth.uid).classIds.includes(classId));

      allow create, delete: if isAdmin();

      // Admins can update anything.
      // Teachers can update their own classes, but cannot re-assign the teacher.
      allow update: if isAdmin() ||
                     (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId);
    }

    // Rules for 'classMemberships' collection
    match /classMemberships/{membershipId} {
      function isAssignedTeacherForClass(classId) {
        let classDoc = get(/databases/$(database)/documents/classes/$(classId));
        return isTeacher() && classDoc.data.teacherId == request.auth.uid;
      }

      allow read: if isAdmin() || isAssignedTeacherForClass(resource.data.classId) || isOwner(resource.data.studentId);
      // CRITICAL SECURITY FIX: All membership mutations MUST go through the callable functions
      // to ensure transactional integrity of studentCount and user.classIds.
      allow create, delete: if false;
    }

    // --- Course & Lesson Management ---

    function isCourseOwner(courseId) {
      let courseDoc = get(/databases/$(database)/documents/courses/$(courseId));
      return isTeacher() && courseDoc.data.teacherId == request.auth.uid;
    }

    function isEnrolledInCourse(courseId) {
      let courseDoc = get(/databases/$(database)/documents/courses/$(courseId));
      let user = getUserData(request.auth.uid);
      // A student is enrolled if the course is published and is assigned to any of the student's classes.
      return courseDoc.data.status == 'published' && courseDoc.data.classIds.hasAny(user.classIds);
    }

    match /courses/{courseId} {
      // Read: Admins, the owner teacher, or an enrolled student.
      allow read: if isAdmin() || isCourseOwner(courseId) || isEnrolledInCourse(courseId);
      // Write: Admins or teachers (for creating).
      allow create: if isAdmin() || isTeacher();
      // Update/Delete: Admins or the owner teacher.
      allow update, delete: if isAdmin() || isCourseOwner(courseId);
    }

    match /modules/{moduleId} {
      // Access is derived from the parent course.
      allow read: if isAdmin() || isCourseOwner(resource.data.courseId) || isEnrolledInCourse(resource.data.courseId);
      // Write access is granted to the course owner or an admin.
      allow write: if isAdmin() || isCourseOwner(request.resource.data.courseId);
    }

    match /lessons/{lessonId} {
      function getCourseIdFromLesson(lessonData) {
        let moduleDoc = get(/databases/$(database)/documents/modules/$(lessonData.moduleId));
        return moduleDoc.data.courseId;
      }

      // Access is derived from the parent course via the module.
      allow read: if isAdmin() || isCourseOwner(getCourseIdFromLesson(resource.data)) || isEnrolledInCourse(getCourseIdFromLesson(resource.data));
      // Write access is granted to the course owner or an admin.
      allow write: if isAdmin() || isCourseOwner(getCourseIdFromLesson(request.resource.data));
    }

    // --- Legacy Lesson/Question Rules (Phase 4) ---

    // Rules for 'lessons' collection (from Phase 4)
    match /lessons/{lessonId} {
      function isAssignedTeacherForLesson(lessonData) {
        let classDoc = get(/databases/$(database)/documents/classes/$(lessonData.classId));
        return isTeacher() && classDoc.data.teacherId == request.auth.uid;
      }

      // Admins, the assigned teacher, or an enrolled student (for published lessons) can read.
      allow read: if isAdmin() ||
                     isAssignedTeacherForLesson(resource.data) ||
                     (resource.data.status == 'published' && getUserData(request.auth.uid).classIds.includes(resource.data.classId));

      // Only admins or the assigned teacher can create/delete.
      allow create, delete: if isAdmin() || isAssignedTeacherForLesson(request.resource.data);

      // Admins can update anything.
      // Teachers can update their own lessons, but cannot change classId or createdBy.
      allow update: if isAdmin() ||
                     (isAssignedTeacherForLesson(resource.data) &&
                      request.resource.data.classId == resource.data.classId &&
                      request.resource.data.createdBy == resource.data.createdBy);
    }

    // Rules for 'questions' collection (from Phase 4)
    match /questions/{questionId} {
      function isAssignedTeacherForQuestion(questionData) {
        let lessonDoc = get(/databases/$(database)/documents/lessons/$(questionData.lessonId));
        return isTeacher() && isAssignedTeacherForLesson(lessonDoc.data);
      }

      // Only admins or the assigned teacher can read/create/update/delete questions.
      // Students should NOT read questions directly, as they contain correct answers.
      allow read, create, update, delete: if isAdmin() || isAssignedTeacherForQuestion(request.resource.data);
    }

    // Rules for 'assignments' collection
    match /assignments/{assignmentId} {
      function isAssignedTeacherForAssignment(assignmentData) {
        let classDoc = get(/databases/$(database)/documents/classes/$(assignmentData.classId));
        return isTeacher() && classDoc.data.teacherId == request.auth.uid;
      }

      // Admins, the assigned teacher, or an enrolled student (for published assignments) can read.
      allow read: if isAdmin() ||
                     isAssignedTeacherForAssignment(resource.data) ||
                     (resource.data.status == 'published' && getUserData(request.auth.uid).classIds.includes(resource.data.classId));

      // Only admins or the assigned teacher can create/delete.
      allow create, delete: if isAdmin() || isAssignedTeacherForAssignment(request.resource.data);

      // Admins can update anything.
      // Teachers can update their own assignments, but cannot change classId, lessonId, createdBy,
      // or questionIds after publishing.
      allow update: if isAdmin() ||
                     (isAssignedTeacherForAssignment(resource.data) &&
                      request.resource.data.classId == resource.data.classId &&
                      request.resource.data.lessonId == resource.data.lessonId &&
                      request.resource.data.createdBy == resource.data.createdBy &&
                      (resource.data.status == 'draft' ||
                       (resource.data.status == 'published' &&
                        request.resource.data.questionIds == resource.data.questionIds)));
    }

    // Rules for 'assignmentQuestions' collection (student-readable snapshot of questions)
    match /assignmentQuestions/{assignmentQuestionId} {
      function isStudentForAssignmentQuestion(aqData) {
        let assignmentDoc = get(/databases/$(database)/documents/assignments/$(aqData.assignmentId));
        return assignmentDoc.data.status == 'published' && getUserData(request.auth.uid).classIds.includes(assignmentDoc.data.classId);
      }

      // Admins, teachers (for their assignments), or students (for published assignments in their class) can read.
      allow read: if isAdmin() || isAssignedTeacherForAssignment(get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data) || isStudentForAssignmentQuestion(resource.data);
      // No one can create/update/delete directly. These are created via assignment publish.
      allow create, update, delete: if false;
    }

    // Rules for 'assignmentAnswerKeys' collection (teacher/admin-only correct answers)
    match /assignmentAnswerKeys/{answerKeyId} {
      function isAssignedTeacherForAnswerKey(akData) {
        let assignmentDoc = get(/databases/$(database)/documents/assignments/$(akData.assignmentId));
        return isTeacher() && isAssignedTeacherForAssignment(assignmentDoc.data);
      }

      // Only admins and teachers can read. Students are explicitly denied.
      allow read: if isAdmin() || isAssignedTeacherForAnswerKey(resource.data);
      // No one can create/update/delete directly. These are created via assignment publish.
      allow create, update, delete: if false;
    }

    // Rules for 'submissions' collection
    match /submissions/{submissionId} {
      function isAssignedTeacherForSubmission(subData) {
        let assignmentDoc = get(/databases/$(database)/documents/assignments/$(subData.assignmentId));
        return isTeacher() && isAssignedTeacherForAssignment(assignmentDoc.data);
      }

      // Admins can do anything. Teachers can read/update submissions for their assignments. Students can read/update their own.
      allow read: if isAdmin() || isAssignedTeacherForSubmission(resource.data) || isOwner(resource.data.studentId);
      allow create: if isOwner(request.resource.data.studentId); // Student can create their own submission
      allow update: if isAdmin() || (isAssignedTeacherForSubmission(resource.data) && request.resource.data.studentId == resource.data.studentId) || (isOwner(resource.data.studentId) && resource.data.status == 'in_progress' && request.resource.data.status == 'in_progress'); // Teachers can grade, students can update in_progress
      allow delete: if isAdmin(); // Only admins can delete submissions
    }

    // Rules for 'submissionAnswers' collection
    match /submissionAnswers/{answerId} {
      function isAssignedTeacherForSubmissionAnswer(saData) {
        let submissionDoc = get(/databases/$(database)/documents/submissions/$(saData.submissionId));
        return isTeacher() && isAssignedTeacherForSubmission(submissionDoc.data);
      }

      // Admins can do anything. Teachers can read/update answers for their assignments. Students can read/update their own.
      allow read: if isAdmin() || isAssignedTeacherForSubmissionAnswer(resource.data) || isOwner(resource.data.studentId);
      allow create: if isOwner(request.resource.data.studentId); // Student can create their own answers
      allow update: if isAdmin() || (isAssignedTeacherForSubmissionAnswer(resource.data) && request.resource.data.studentId == resource.data.studentId) || (isOwner(resource.data.studentId) && get(/databases/$(database)/documents/submissions/$(resource.data.submissionId)).data.status == 'in_progress' && request.resource.data.studentId == resource.data.studentId); // Teachers can grade, students can update in_progress
      allow delete: if isAdmin(); // Only admins can delete answers
    }
  }
}